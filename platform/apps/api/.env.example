# ---- Server ----
PORT=4000
# Change this to a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (the three apps). Use * to allow all.
CORS_ORIGINS=http://localhost:5201,http://localhost:5202,http://localhost:5203
# Timezone the clinic operates in. Used for "today", past-slot checks and analytics.
CLINIC_TIMEZONE=Asia/Kolkata

# ---- Database ----
# sqlite  -> zero setup, stores everything in SQLITE_FILE (great for local development)
# postgres -> production; set DATABASE_URL
DB_CLIENT=sqlite
SQLITE_FILE=./data/medislot.db
# DATABASE_URL=postgres://medislot:medislot@localhost:5432/medislot
# Set to true when your Postgres host requires SSL (most managed providers do)
# DATABASE_SSL=true
